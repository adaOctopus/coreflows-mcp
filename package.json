{
  "name": "coolplugz-core",
  "version": "1.0.0",
  "description": "Open-source MCP orchestrator for Jira → GitHub dev workflows. Fetches context from Jira/GitHub/Notion/Slack, builds CRISPE prompts, manages branches/PRs — all as MCP tools for Claude Code.",
  "main": "dist/index.js",
  "scripts": {
