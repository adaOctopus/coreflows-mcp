# ── Required ─────────────────────────────────────────────
GITHUB_TOKEN=ghp_...          # GitHub Personal Access Token (repo + workflow scopes)

# ── Jira (optional — enables Jira context fetching) ──────
JIRA_API_TOKEN=               # API token from https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=you@company.com    # Your Atlassian account email
JIRA_BASE_URL=https://yourworkspace.atlassian.net

# ── Notion (optional — enables Notion doc fetching) ──────
NOTION_TOKEN=ntn_...          # Internal integration token from https://www.notion.so/my-integrations

# ── Slack (optional — enables Slack mention tracking) ────
SLACK_TOKEN=xoxb-...          # Bot User OAuth Token with channels:history, search:read

# ── AI-powered features (optional) ──────────────────────
ANTHROPIC_API_KEY=sk-ant-...  # Enables smart Slack reply drafts & repo detection from ticket text

# ── Server ───────────────────────────────────────────────
PORT=3100                     # MCP server port (default: 3100)

# ── Workspace (your local dev setup) ────────────────────
SHELL_ENV=wsl2                # wsl2 | git-bash | powershell | macos | linux
REPOS_ROOT=/home/you/projects # Absolute path to where your repos are cloned
WSL_DISTRO=Ubuntu             # Only needed if SHELL_ENV=wsl2
